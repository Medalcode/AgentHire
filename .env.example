# =============================================================================
# AgentHire — .env.example
# Copy this file to .env and fill in real values before running docker compose.
#
# SECURITY NOTES:
#   - Never commit .env to version control (it is in .gitignore).
#   - Portal passwords and API keys are stored only in .env; they are passed
#     into containers as environment variables and NEVER persisted to the DB
#     in plaintext. If you need to store credentials in the DB, encrypt them
#     first with a KMS or Vault-derived key.
#   - Rotate N8N_ENCRYPTION_KEY only when n8n credentials are re-entered.
#   - Use a secrets manager (AWS SSM, GCP Secret Manager) in production.
# =============================================================================


# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=agenthire
POSTGRES_USER=agenthire
POSTGRES_PASSWORD=changeme_strong_password

# Full asyncpg / SQLAlchemy DSN used by Python agents
DATABASE_URL=postgresql+asyncpg://agenthire:changeme_strong_password@postgres:5432/agenthire


# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0


# -----------------------------------------------------------------------------
# n8n Workflow Orchestrator
# -----------------------------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
# Public URL n8n uses to generate webhook URLs (must be reachable by portals)
N8N_WEBHOOK_URL=http://localhost:5679
# 32-character random string — generate with: openssl rand -hex 16
N8N_ENCRYPTION_KEY=changeme_32_char_key_here_!!!!!


# -----------------------------------------------------------------------------
# LLM Provider
# Set LLM_PROVIDER to "openai", "gemini", or "qwen".
# Only the matching API key is required.
# -----------------------------------------------------------------------------
LLM_PROVIDER=qwen

# Local Qwen (via Ollama)
# If Ollama runs on your host machine, use host.docker.internal inside Docker
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5-coder:7b

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-4o-mini

# Google Gemini (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# LLM_MODEL=gemini-1.5-flash   # uncomment if using Gemini


# -----------------------------------------------------------------------------
# agent-browser MCP Server
# Internal Docker URL — agents call this to drive the browser
# -----------------------------------------------------------------------------
AGENT_BROWSER_MCP_URL=http://agent-browser:8765


# -----------------------------------------------------------------------------
# Portal Credentials
# SECURITY: These are injected as env vars only; never written to DB in plain.
#           Consider encrypting at rest with a KMS key for production.
# -----------------------------------------------------------------------------

# LinkedIn
LINKEDIN_EMAIL=tu@email.com
LINKEDIN_PASSWORD=changeme

# ChileTrabajos
CHILETRABAJOS_EMAIL=tu@email.com
CHILETRABAJOS_PASSWORD=changeme

# Computrabajo
COMPUTRABAJO_EMAIL=tu@email.com
COMPUTRABAJO_PASSWORD=changeme

# Trabajando.com
TRABAJANDO_EMAIL=tu@email.com
TRABAJANDO_PASSWORD=changeme

# Laborum
LABORUM_EMAIL=tu@email.com
LABORUM_PASSWORD=changeme


# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# When TRUE, the apply-agent pauses and waits for human confirmation before
# submitting each application. Set to FALSE to run fully autonomously.
REQUIRE_HUMAN_APPROVAL=true


# -----------------------------------------------------------------------------
# Document / PDF Output
# -----------------------------------------------------------------------------
# Mounted as a Docker volume — maps to ./outputs on the host
OUTPUT_DIR=/app/outputs


# -----------------------------------------------------------------------------
# Dashboard (Next.js)
# NEXT_PUBLIC_* variables are inlined at build time and accessible client-side.
# For server-side API routes, use the internal Docker service URLs above.
# -----------------------------------------------------------------------------
# Exposed to the browser — must point to a publicly reachable URL in production
NEXT_PUBLIC_TRACKER_URL=http://localhost:8006
