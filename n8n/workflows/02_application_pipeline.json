{
  "name": "02_Application_Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "1",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, portal, url FROM jobs WHERE status = 'discovered' LIMIT 20;"
      },
      "id": "2",
      "name": "Get Discovered Jobs",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.2,
      "position": [
        300,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "AgentHire DB"
        }
      }
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "3",
      "name": "Loop Jobs",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 2,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://agent-backend:8000/ranking/run",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "task",
              "value": "rank_job"
            },
            {
              "name": "context",
              "value": "={{ JSON.stringify({job_id: $json.id}) }}"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "id": "4",
      "name": "Agent Ranking",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.result.score }}",
              "operation": "largerEqual",
              "value2": 70
            }
          ]
        }
      },
      "id": "5",
      "name": "Score >= 70?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://agent-backend:8000/cv/run",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "task",
              "value": "generate_cv"
            },
            {
              "name": "context",
              "value": "={{ JSON.stringify({job_id: $('Loop Jobs').item.json.id}) }}"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "id": "6",
      "name": "Agent CV",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1100,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://agent-backend:8000/cover/run",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "task",
              "value": "generate_cover"
            },
            {
              "name": "context",
              "value": "={{ JSON.stringify({job_id: $('Loop Jobs').item.json.id}) }}"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "id": "7",
      "name": "Agent Cover",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1100,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://agent-backend:8000/apply/run",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "task",
              "value": "apply"
            },
            {
              "name": "context",
              "value": "={{ JSON.stringify({job_id: $('Loop Jobs').item.json.id, cv_id: $('Agent CV').item.json.result.doc_id, cover_id: $('Agent Cover').item.json.result.doc_id}) }}"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "id": "8",
      "name": "Agent Apply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1300,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE jobs SET status = 'discarded' WHERE id = '{{ $('Loop Jobs').item.json.id }}';"
      },
      "id": "9",
      "name": "Set Discarded",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.2,
      "position": [
        1100,
        600
      ],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "AgentHire DB"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Get Discovered Jobs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Discovered Jobs": {
      "main": [
        [
          {
            "node": "Loop Jobs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop Jobs": {
      "main": [
        [
          {
            "node": "Agent Ranking",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Agent Ranking": {
      "main": [
        [
          {
            "node": "Score >= 70?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Score >= 70?": {
      "main": [
        [
          {
            "node": "Agent CV",
            "type": "main",
            "index": 0
          },
          {
            "node": "Agent Cover",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Set Discarded",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Agent CV": {
      "main": [
        [
          {
            "node": "Agent Apply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Discarded": {
      "main": [
        [
          {
            "node": "Loop Jobs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Agent Apply": {
      "main": [
        [
          {
            "node": "Loop Jobs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
